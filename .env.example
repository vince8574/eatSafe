# Environment Variables Example
# Copy this file to .env and fill in your actual API keys

# Google Cloud Vision API
# Get your API key from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
EXPO_PUBLIC_VISION_API_KEY=your_google_vision_api_key_here

# Claude OCR fallback (3rd-tier, server-side proxy to Anthropic)
# The Cloud Function URL returned by `firebase deploy --only functions:ocrClaude`.
# The Anthropic API key itself never lives in the app — it's a Firebase Secret
# stored in Google Secret Manager on the server side. See
# firebase/functions/CLAUDE_OCR_DEPLOYMENT.md for the full setup.
EXPO_PUBLIC_CLAUDE_ENDPOINT=https://us-central1-<YOUR_PROJECT_ID>.cloudfunctions.net/ocrClaude

# Note: In production, use EAS Secrets instead of .env files
# Run: eas secret:create --scope project --name EXPO_PUBLIC_VISION_API_KEY --value your_actual_key
