{
  "functions": [
    {
      "source": "firebase/functions",
      "codebase": "eatsafe",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    },
    {
      "source": "firebase/functions-usda",
      "codebase": "usda",
      "ignore": [
        "venv",
        ".git",
        "**/__pycache__",
        "*.local"
      ]
    }
  ]
}
